<script>
const startYear = 2024;
let elem = document.getElementById("Year-Range");

function updateYear() {
    const elem = document.getElementById("Year-Range");
    if (!elem) return;
    const currentYear = new Date().getFullYear();
    elem.textContent = startYear === currentYear ? `${startYear}` : `${startYear}-${currentYear}`;
}

document.addEventListener("astro:page-load", updateYear);
</script>